# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/inscribe_db
DB_USERNAME=inscribe
DB_PASSWORD=change-this-password
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# JWT
JWT_SECRET=replace-with-64-plus-character-random-secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Auth rate limiting
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET=inscribe-blog-storage
AWS_S3_MAX_UPLOAD_SIZE_BYTES=10485760
AWS_S3_UPLOAD_URL_DURATION_MINUTES=10
AWS_S3_VIEW_URL_DURATION_MINUTES=60
AWS_S3_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp
